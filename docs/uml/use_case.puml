@startuml
title Diagramme de cas d'utilisation - TranscriBITE
left to right direction

actor "Utilisateur" as User

rectangle "TranscriBITE" {
    usecase "Importer un fichier audio/vidéo" as UC1
    usecase "Choisir la langue" as UC2
    usecase "Choisir la longueur du résumé" as UC3
    usecase "Lancer le traitement" as UC4
    usecase "Suivre la progression" as UC5
    usecase "Consulter la transcription" as UC6
    usecase "Prévisualiser le média" as UC7
    usecase "Générer un résumé du fichier" as UC8
    usecase "Transcrire en direct" as UC9
    usecase "Générer un résumé live" as UC10
    usecase "Télécharger le résultat" as UC11
    usecase "Vérifier l'état du système" as UC12
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10
User --> UC11
User --> UC12

UC4 .> UC1 : <<include>>
UC4 .> UC2 : <<include>>
UC4 .> UC3 : <<include>>
UC9 .> UC2 : <<include>>
UC10 .> UC9 : <<extend>>
@enduml
