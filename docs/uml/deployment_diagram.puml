@startuml
title Diagramme de déploiement - TranscriBITE

node "Machine utilisateur" as PC {
    node "Navigateur Web" as Browser {
        artifact "Frontend React / Vite" as Frontend
        artifact "Web Speech API" as SpeechAPI
    }

    node "Serveur local Python" as Python {
        artifact "FastAPI + Uvicorn" as Backend
        artifact "Faster-Whisper" as Whisper
        artifact "FFmpeg / FFprobe" as MediaTools
    }

    node "Service Ollama local" as OllamaNode {
        artifact "Modèle gemma2:2b" as OllamaModel
    }

    node "Système de fichiers local" as Storage {
        artifact "storage/uploads/" as Uploads
        artifact "storage/outputs/" as Outputs
        artifact "storage/cache/processing_states.json" as Cache
        artifact "logs/" as Logs
    }
}

Browser --> Backend : HTTP REST
Browser --> SpeechAPI : microphone / transcription live
Backend --> MediaTools : analyse et extraction média
Backend --> Whisper : transcription fichier
Backend --> OllamaModel : résumé via HTTP localhost:11434
Backend --> Uploads : lecture / écriture
Backend --> Outputs : WAV et résultats TXT/JSON/PDF
Backend --> Cache : état et progression
Backend --> Logs : journalisation

note right of PC
    Traitement des fichiers local.
    Aucun service cloud requis pour
    l'upload, la transcription fichier
    et le résumé.
    Le mode live dépend du navigateur.
end note
@enduml
